{
  "policy_id": "CORVO-PROC-POL-04",
  "title": "Corvo Engineering Procurement Policy (PR to PO)",
  "version": "5.0",
  "effective_date": "2026-04-01",
  "parameters": {
    "club_window_days": 14,
    "club_need_by_days": 7,
    "price_lookback_days": 365,
    "history_lookback_days": 365,
    "preferred_lookback_days": 548
  },
  "rules": [
    {
      "id": "1.2",
      "clause": "1.2",
      "name": "New item",
      "when": {"field": "item_is_new", "op": "==", "value": true},
      "outcome": {"decision": "SOURCING_REQUEST", "route": "NEW_ITEM_SOURCING", "supplier": {"mode": "none"}}
    },
    {
      "id": "5.1",
      "clause": "5.1",
      "name": "Capex",
      "when": {"field": "item_type", "op": "==", "value": "Capex"},
      "outcome": {"decision": "SOURCING_REQUEST", "route": "CAPEX_SOURCING", "supplier": {"mode": "suggest", "count": 5}, "notes": "Needs capex approval"}
    },
    {
      "id": "5.2",
      "clause": "5.2",
      "name": "Rate contract",
      "when": {"field": "contract_usable", "op": "==", "value": true},
      "outcome": {"decision": "PO", "route": "CONTRACT_PO", "supplier": {"mode": "contract"}}
    },
    {
      "id": "5.3",
      "clause": "5.3",
      "name": "Emergency PO",
      "when": {"all": [
        {"field": "is_emergency", "op": "==", "value": true},
        {"field": "value", "op": "<=", "value": 500000},
        {"field": "bought_recently", "op": "==", "value": true}
      ]},
      "outcome": {"decision": "PO", "route": "EMERGENCY_PO", "supplier": {"mode": "preferred_first"}}
    },
    {
      "id": "5.4",
      "clause": "5.4",
      "name": "Spot PO",
      "when": {"all": [
        {"field": "value", "op": "<", "value": 200000},
        {"field": "bought_recently", "op": "==", "value": true}
      ]},
      "outcome": {"decision": "PO", "route": "SPOT_PO", "supplier": {"mode": "preferred_first"}}
    },
    {
      "id": "5.5",
      "clause": "5.5",
      "name": "RFQ",
      "when": {"field": "value", "op": "<", "value": 1000000},
      "outcome": {"decision": "SOURCING_REQUEST", "route": "RFQ", "supplier": {"mode": "suggest", "count": 3}}
    },
    {
      "id": "5.6",
      "clause": "5.6",
      "name": "RFP",
      "when": {"field": "value", "op": ">=", "value": 1000000},
      "outcome": {"decision": "SOURCING_REQUEST", "route": "RFP", "supplier": {"mode": "suggest", "count": 5}}
    }
  ],
  "fallback_outcome": {"decision": "SOURCING_REQUEST", "route": "RFQ", "supplier": {"mode": "suggest", "count": 3}},
  "supplier_ranking": {
    "weights": {"frequency": 0.30, "recency": 0.25, "contract": 0.15, "on_time": 0.15, "quality": 0.15},
    "frequency_cap": 5,
    "recency_full_days": 90,
    "recency_half_days": 365,
    "topup_weights": {"on_time": 0.5, "quality": 0.5}
  },
  "consolidation": {"enabled": true, "window_hours": 24, "same": ["supplier_id", "plant", "route"]},
  "eligible_supplier_statuses": ["Active"]
}
